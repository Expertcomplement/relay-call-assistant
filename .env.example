# OpenAI-independent default: Vapi for calling, Gemini for the voice model.
VOICE_PROVIDER=vapi
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=
VAPI_MODEL_PROVIDER=google
VAPI_MODEL=gemini-2.5-flash
VAPI_TRANSCRIBER_PROVIDER=deepgram
VAPI_TRANSCRIBER_MODEL=nova-3
VAPI_VOICE_PROVIDER=vapi
VAPI_VOICE_ID=Elliot
VAPI_VOICE_VERSION=2

# Turn on only after setting the phone number Server URL and its Bearer credential
# to https://YOUR_HOST/webhooks/vapi and VAPI_WEBHOOK_SECRET respectively.
INBOUND_ENABLED=false
VAPI_WEBHOOK_SECRET=

# App sign-in and server settings.
APP_PASSWORD=change-this-to-a-long-unique-password
SESSION_SECRET=generate-a-random-secret-of-at-least-32-characters
HOST=127.0.0.1
PORT=3030
APP_NAME=Relay
OWNER_NAME=Your Name

# Optional legacy provider. Use VOICE_PROVIDER=openai_live to enable it.
# The SIP trunk must support TLS signaling and SDES-SRTP.
OPENAI_API_KEY=
OPENAI_WEBHOOK_SECRET=
SIP_PROVIDER_URL=sips:your-trunk.example.com:5061
SIP_USERNAME=
SIP_PASSWORD=
SIP_CALLER_NUMBER=+15551234567
