# OpenAI API project key and the signing secret for its Live incoming-call webhook
OPENAI_API_KEY=
OPENAI_WEBHOOK_SECRET=

# Required to protect the app when it is reachable from the internet.
APP_PASSWORD=change-this-to-a-long-unique-password
SESSION_SECRET=generate-a-random-secret-of-at-least-32-characters

# SIP provider settings. The trunk must support TLS signaling and SDES-SRTP media.
SIP_PROVIDER_URL=sips:your-trunk.example.com:5061
SIP_USERNAME=
SIP_PASSWORD=
SIP_CALLER_NUMBER=+15551234567

# Inbound calls are accepted only when enabled and the OpenAI webhook is configured.
INBOUND_ENABLED=false
HOST=127.0.0.1
PORT=3030
APP_NAME=Relay
OWNER_NAME=Your Name
